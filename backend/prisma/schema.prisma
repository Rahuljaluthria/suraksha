generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id                  String     @id @default(cuid()) @db.VarChar(191)
  email               String     @unique @db.VarChar(191)
  firstName           String     @db.VarChar(100)
  lastName            String     @db.VarChar(100)
  passwordHash        String     @db.VarChar(255)

  status              UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt     DateTime?
  passwordChangedAt   DateTime   @default(now())

  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  roles               UserRole[]
  refreshSessions     RefreshSession[]
  auditLogs           AuditLog[] @relation("AuditActor")

  reportedIncidents       Incident[]           @relation("ReportedIncidents")
  assignedIncidents       Incident[]           @relation("AssignedIncidents")
  incidentAssignments     IncidentAssignment[] @relation("UserAssignments")
  assignedByAssignments   IncidentAssignment[] @relation("AssignerAssignments")
  incidentHistoryActions IncidentHistory[]    @relation("HistoryActor")
  ledInvestigations       Investigation[]      @relation("InvestigationLead")

  @@index([status])
  @@index([createdAt])
}

model Role {
  id          String   @id @default(cuid()) @db.VarChar(191)
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model UserRole {
  userId     String   @db.VarChar(191)
  roleId     String   @db.VarChar(191)
  assignedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Permission {
  id          String   @id @default(cuid()) @db.VarChar(191)
  key         String   @unique @db.VarChar(150)
  description String?  @db.VarChar(255)

  createdAt   DateTime @default(now())

  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.VarChar(191)
  permissionId String     @db.VarChar(191)
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshSession {
  id          String    @id @default(cuid()) @db.VarChar(191)
  userId      String    @db.VarChar(191)

  tokenHash   String    @unique @db.VarChar(255)
  familyId    String    @db.VarChar(191)

  userAgent   String?   @db.VarChar(500)
  ipAddress   String?   @db.VarChar(45)

  expiresAt   DateTime
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  revokeReason String?  @db.VarChar(100)

  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@index([revokedAt])
}

model AuditLog {
  id         String   @id @default(cuid()) @db.VarChar(191)
  actorId    String?  @db.VarChar(191)

  action     String   @db.VarChar(150)
  entityType String?  @db.VarChar(100)
  entityId   String?  @db.VarChar(191)

  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(500)
  metadata   Json?

  createdAt  DateTime @default(now())

  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentPriority {
  P1
  P2
  P3
  P4
}

enum IncidentStatus {
  NEW
  TRIAGED
  ASSIGNED
  INVESTIGATING
  REMEDIATING
  VERIFYING
  RESOLVED
  CLOSED
  REJECTED
  REOPENED
  ESCALATED
}

model Incident {
  id             String           @id @default(cuid()) @db.VarChar(191)
  incidentNumber String           @unique @db.VarChar(50)
  title          String           @db.VarChar(255)
  description    String           @db.Text
  severity       IncidentSeverity @default(MEDIUM)
  priority       IncidentPriority @default(P3)
  status         IncidentStatus   @default(NEW)
  category       String           @db.VarChar(100)
  tags           Json?

  reportedById   String           @db.VarChar(191)
  assignedToId   String?          @db.VarChar(191)

  resolvedAt     DateTime?
  closedAt       DateTime?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  reportedBy     User             @relation("ReportedIncidents", fields: [reportedById], references: [id])
  assignedTo     User?            @relation("AssignedIncidents", fields: [assignedToId], references: [id], onDelete: SetNull)

  assignments    IncidentAssignment[]
  history        IncidentHistory[]
  investigation  Investigation?

  @@index([status])
  @@index([severity])
  @@index([priority])
  @@index([reportedById])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([category])
}

model IncidentAssignment {
  id           String    @id @default(cuid()) @db.VarChar(191)
  incidentId   String    @db.VarChar(191)
  userId       String    @db.VarChar(191)
  role         String    @default("PRIMARY_RESPONDER") @db.VarChar(50)
  assignedById String?   @db.VarChar(191)
  isActive     Boolean   @default(true)
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  incident     Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user         User      @relation("UserAssignments", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User?     @relation("AssignerAssignments", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([incidentId, isActive])
  @@index([userId, isActive])
}

model IncidentHistory {
  id         String          @id @default(cuid()) @db.VarChar(191)
  incidentId String          @db.VarChar(191)
  actorId    String?         @db.VarChar(191)
  action     String          @db.VarChar(100)
  fromStatus IncidentStatus?
  toStatus   IncidentStatus?
  notes      String?         @db.Text
  metadata   Json?
  createdAt  DateTime        @default(now())

  incident   Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor      User?           @relation("HistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@index([actorId])
}

model Investigation {
  id          String    @id @default(cuid()) @db.VarChar(191)
  incidentId  String    @unique @db.VarChar(191)
  leadId      String?   @db.VarChar(191)
  summary     String?   @db.Text
  hypotheses  Json?
  findings    String?   @db.Text
  rootCause   String?   @db.Text
  status      String    @default("OPEN") @db.VarChar(50)
  startedAt   DateTime  @default(now())
  concludedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  lead        User?     @relation("InvestigationLead", fields: [leadId], references: [id], onDelete: SetNull)
}
