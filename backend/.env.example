# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# MySQL (Prisma + MariaDB adapter)
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3307/suraksha

# Redis (permission cache, health)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=localhost:9094

# Auth. JWT_ACCESS_SECRET must be a long random string (32+ characters) and must be set in every environment.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_ISSUER=suraksha-api
JWT_AUDIENCE=suraksha-client
REFRESH_TOKEN_EXPIRY_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=suraksha_refresh_token
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
REQUIRE_EMAIL_VERIFICATION=false

# ---------------------------------------------------------------------------
# AI assistance (DeepSeek). Optional: without a key the AI endpoints answer
# 503 AI_NOT_CONFIGURED and everything else keeps working.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
# Must be https (http is accepted only for localhost). Defaults shown.
#DEEPSEEK_BASE_URL=https://api.deepseek.com
#DEEPSEEK_MODEL=deepseek-flash
#AI_ENABLED=true
#AI_TIMEOUT_MS=30000
#AI_MAX_CONCURRENCY=4
#AI_RATE_LIMIT_MAX=15
#AI_RATE_LIMIT_WINDOW_MINUTES=10
# none = keep IP addresses (useful indicators), private = mask RFC1918 ranges, all = mask every IPv4
#AI_MASK_IPS=none
